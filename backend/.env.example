# ====================================================
# HIREPUR ENTERPRISE UPGRADE - BACKEND ENVIRONMENT CONFIG
# ====================================================

# Base Configuration
PORT=5000
NODE_ENV=production

# Client Application URL (For CORS controls)
CLIENT_URL=https://hirepur-frontend.vercel.app

# Database Connection Config (TiDB / MySQL Compatible)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=yoursecurepassword
DB_NAME=hirepur

# Cryptographic Token Keys (Generate secure random keys in production)
JWT_SECRET=supersecretjwtkey_hirepur_jobportal_2026
JWT_REFRESH_SECRET=supersecretrefreshkey_hirepur_jobportal_2026

# Email Dispatch Configurations (SMTP)
SMTP_SERVICE=gmail
SMTP_USER=name@gmail.com
SMTP_PASS=appspecificpassword

# Alternate environment keys
EMAIL_USER=name@gmail.com
EMAIL_PASS=appspecificpassword

# Cloudinary CDN Storage (Resumes, Avatars, Logos)
CLOUDINARY_CLOUD=yourcloudinarycloudname
CLOUDINARY_KEY=yourcloudinarykey
CLOUDINARY_SECRET=yourcloudinarysecret
